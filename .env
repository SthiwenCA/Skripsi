## 1. PENGATURAN UTAMA APLIKASI
APP_NAME="Map Kerusakan Jalan"
APP_ENV=local
APP_KEY=base64:bD26ck/6jUVjBV4tc6VQGCbrWip6uNR/4LZgxwwa4JE=
APP_DEBUG=true
APP_URL=http://localhost

## 2. PENGATURAN BAHASA & LOKAL
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

## 3. PENGATURAN MODE PERBAIKAN
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

## 4. PENGATURAN PENCATATAN ERROR (LOGGING)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## 5. PENGATURAN DATABASE (KONEKSI KE XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_map_kerusakan
DB_USERNAME=root
DB_PASSWORD=

## 6. PENGATURAN SESI (DATA LOGIN USER)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

## 7. PENGATURAN FILE, ANTRIAN & CACHE
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## 8. PENGATURAN EMAIL (UNTUK LUPA PASSWORD LOCALHOST)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

## 9. PENGATURAN CLOUD AWS (KOSONG)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

## 10. PENGATURAN FRONTEND (VITE)
VITE_APP_NAME="${APP_NAME}"